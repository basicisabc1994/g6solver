    "measures": {
      "task_success": "final kept diff passes every registered hidden check; unknown if not observed; abandoned or unfinished ended session fails",
      "defects": "registered defect IDs; independent adjudicator maps G6 claims to IDs and evaluates hidden checks on the snapshot reviewed; false=confirmed defect, true=false alarm; unknown and unmatched claims reported",
      "missed": "confirmed defects not claimed by G6, even if the agent independently repairs them; alone therefore has no G6 finds",
      "wall_time": "full started session elapsed wall seconds, including waits, retries and G6",
      "cost_or_calls": "reported total model cost in USD, otherwise exact model-call count, including delegated G6 calls; null when not recorded, with coverage; never estimated",
      "abandonment": "started and ended session without a kept final diff; empty kept diff is not abandonment; unrun and ongoing separately",
      "calibration": "each exact completion/review label once per session; share with a passing final diff, full labelled denominator and unknown count; verified is unexpected and flagged",
      "retention": "B retained-A-history versus identical B fresh, paired, no new release bar"
    },
