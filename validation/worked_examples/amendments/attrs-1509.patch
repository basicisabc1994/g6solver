 class TestMakeOrder:
diff --git a/tests/utils.py b/tests/utils.py
index f42f1a9..d9a9f00 100644
--- a/tests/utils.py
+++ b/tests/utils.py
@@ -64,5 +64,33 @@ def simple_attr(
         kw_only=kw_only,
         inherited=inherited,
         alias=_default_init_alias_for(name),
-        alias_is_default=True,
     )
+
+
+def fields_view(attributes):
+    """
+    What comparing tuples of `Attribute` checks at the parent commit, so that
+    a field a fix adds to `Attribute` for its own use is not compared: a tuple
+    of exactly `Attribute`, and the fields `Attribute.__eq__` compares.
+    """
+    assert isinstance(attributes, tuple)
+    assert all(a.__class__ is Attribute for a in attributes)
+    names = (
+        "name",
+        "default",
+        "validator",
+        "repr",
+        "eq",
+        "eq_key",
+        "order",
+        "order_key",
+        "hash",
+        "init",
+        "metadata",
+        "type",
+        "converter",
+        "kw_only",
+        "on_setattr",
+        "alias",
+    )
+    return tuple(tuple(getattr(a, n) for n in names) for a in attributes)
